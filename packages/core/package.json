{
  "name": "@astratra/core",
  "version": "1.3.0",
  "description": "Generic core utilities for Astratra SaaS packages.",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src",
    "THIRD-PARTY-NOTICES.md"
  ],
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "scripts": {
    "test": "jest",
    "verify:mutations": "node scripts/verify-google-mutations.cjs && node scripts/verify-upload-mutations.cjs && node scripts/verify-validation-mutations.cjs"
  },
  "keywords": [
    "astratra",
    "saas",
    "core"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astratra/testkit": "^2.0.0",
    "express": "^4.18.3 || ^5.0.0",
    "jest": "30.4.2"
  }
}
