{
  "name": "@astratra/notify",
  "version": "1.3.0",
  "description": "Outbound messages done once — email, SMS and push. Transport injected, never throws, header-injection safe, loud simulation when unconfigured, dead push subscriptions handed back for pruning. Web Push (RFC 8291, VAPID) and APNs built in, no SDK.",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "jest",
    "verify:mutations": "node scripts/verify-web-push-mutations.cjs"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [
    "astratra",
    "email",
    "sms",
    "push",
    "web-push",
    "vapid",
    "notifications",
    "transactional"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@astratra/testkit": "^2.0.0",
    "jest": "30.4.2"
  }
}
