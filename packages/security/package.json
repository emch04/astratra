{
  "name": "@astratra/security",
  "version": "1.15.1",
  "description": "Generic authentication and security middleware for Astratra workspaces.",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "jest",
    "verify:mutations": "node scripts/verify-rate-limit-mutations.cjs && node scripts/verify-jwt-mutations.cjs && node scripts/verify-totp-mutations.cjs"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [
    "astratra",
    "security",
    "auth"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@astratra/core": "^1.0.0",
    "@simplewebauthn/server": "^13.1.2"
  },
  "peerDependencies": {
    "redis": ">=4"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astratra/testkit": "^2.0.0",
    "jest": "30.5.2",
    "redis": "^6.3.1"
  }
}
