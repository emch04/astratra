{
  "name": "@astratra/testkit",
  "version": "2.0.0",
  "description": "Security tests with no dependency (fuzzing, attack catalogue, ReDoS, resource bombs, differential, standard vectors, metamorphic and property tests, constant time, secrets in logs, authorization matrix, races, injected faults, mutations, lockfile checks), plus disposable test databases, per-country fake data and a production database guard.",
  "engines": {
    "node": ">=22.22"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src",
    "jest-preset.js",
    "security.js",
    "security.d.ts"
  ],
  "scripts": {
    "test": "jest && node --test test/*.test.js"
  },
  "jest": {
    "preset": "./jest-preset.js",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [
    "astratra",
    "testing",
    "security",
    "fuzzing",
    "redos",
    "constant-time",
    "authorization",
    "mutation-testing",
    "testcontainers",
    "faker",
    "fixtures"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "peerDependencies": {
    "@babel/plugin-transform-modules-commonjs": ">=7.28.6",
    "@testcontainers/mongodb": ">=12.0.0",
    "@testcontainers/postgresql": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/plugin-transform-modules-commonjs": {
      "optional": true
    },
    "@testcontainers/mongodb": {
      "optional": true
    },
    "@testcontainers/postgresql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@testcontainers/mongodb": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "jest": "30.4.2"
  }
}
