{
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "esModuleInterop": true,
    "module": "CommonJS",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "moduleResolution": "bundler"
  },
  "include": [
    "packages/*/typecheck.ts"
  ]
}
