{
  "name": "astratra",
  "private": true,
  "version": "0.0.0",
  "description": "Astratra: a framework and a set of SDKs for building apps with AI built in.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/dashboard-ui"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:packages": "node scripts/verify-package-installation.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "mongodb": "^6.0.0",
    "redis": "^6.3.1",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  },
  "overrides": {
    "passkit-generator": {
      "joi": "17.13.8"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
